--[[
    XENO CLIENT-ONLY PROCEDURAL REANIMATION
    ---------------------------------------
    - One client script / loadstring-ready
    - NO AnimationIds
    - NO server script
    - 3-second fake-permadeath transition
    - No clone physics, so no fling
    - Corrected R6 bind-axis rotation
    - Preserves head/face/mesh appearance
    - Procedural idle/walk/run/jump/fall/landing

    IMPORTANT:
    This is a client visual reanimation. Roblox does not replicate
    Motor6D.Transform / local clone poses to other clients.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LP = Players.LocalPlayer

local TAU = math.pi * 2
local ID = CFrame.identity
local ZERO = Vector3.zero
local rad = math.rad
local clamp = math.clamp

local CFG = {
    FakePermadeathSeconds = 3,
    RevealSeconds = 0.55,

    WalkLegSwing = 34,
    RunLegSwing = 52,
    WalkArmSwing = 27,
    RunArmSwing = 44,

    RunStartsAt = 16,
    FullRunAt = 26,

    StudsPerCycle = 10.8,
    BodyLean = 7.5,
    BodyBob = 0.072,

    PoseSmoothness = 18,
    VelocitySmoothness = 12,

    ToggleKey = Enum.KeyCode.RightShift,

    HideCloneHeadInFirstPerson = true,
    FirstPersonDistance = 1.1,

    ClientDeathGuard = true,
}

local ENV = _G
pcall(function()
    if getgenv then
        ENV = getgenv()
    end
end)

if type(ENV.__XENO_PROC_REANIM_CLEANUP) == "function" then
    pcall(ENV.__XENO_PROC_REANIM_CLEANUP)
end

local running = true
local enabled = true
local state = nil
local connections = {}
local renderBound = false

local roleByPart = {
    Torso = "root",
    LowerTorso = "root",
    UpperTorso = "waist",
    Head = "neck",

    ["Left Arm"] = "leftShoulder",
    ["Right Arm"] = "rightShoulder",
    ["Left Leg"] = "leftHip",
    ["Right Leg"] = "rightHip",

    LeftUpperArm = "leftShoulder",
    RightUpperArm = "rightShoulder",
    LeftLowerArm = "leftElbow",
    RightLowerArm = "rightElbow",
    LeftHand = "leftWrist",
    RightHand = "rightWrist",

    LeftUpperLeg = "leftHip",
    RightUpperLeg = "rightHip",
    LeftLowerLeg = "leftKnee",
    RightLowerLeg = "rightKnee",
    LeftFoot = "leftAnkle",
    RightFoot = "rightAnkle",
}

local function damp(rate, dt)
    return 1 - math.exp(-rate * dt)
end

local function mix(a, b, t)
    return a + (b - a) * t
end

local function horizontal(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function disconnectAll(list)
    for _, c in ipairs(list) do
        pcall(function()
            c:Disconnect()
        end)
    end
    table.clear(list)
end

local function getControls()
    local ok, controls = pcall(function()
        local module = require(
            LP:WaitForChild("PlayerScripts")
                :WaitForChild("PlayerModule")
        )
        return module:GetControls()
    end)

    return ok and controls or nil
end

local function saveVisibility(s, obj)
    if s.originalVisibility[obj] ~= nil then
        return
    end

    if obj:IsA("BasePart") then
        s.originalVisibility[obj] = {
            kind = "part",
            value = obj.LocalTransparencyModifier,
        }

    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        s.originalVisibility[obj] = {
            kind = "texture",
            value = obj.Transparency,
        }

    elseif obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles")
        or obj:IsA("Highlight")
        or obj:IsA("BillboardGui")
        or obj:IsA("SurfaceGui")
    then
        s.originalVisibility[obj] = {
            kind = "enabled",
            value = obj.Enabled,
        }
    end
end

local function hideOriginal(s, hidden)
    local character = s.character
    if not character or not character.Parent then
        return
    end

    if hidden then
        for _, obj in ipairs(character:GetDescendants()) do
            saveVisibility(s, obj)
        end
    end

    for obj, info in pairs(s.originalVisibility) do
        if obj.Parent then
            if info.kind == "part" then
                obj.LocalTransparencyModifier =
                    hidden and 1 or info.value

            elseif info.kind == "texture" then
                obj.Transparency =
                    hidden and 1 or info.value

            elseif info.kind == "enabled" then
                obj.Enabled =
                    hidden and false or info.value
            end
        end
    end

    s.originalHidden = hidden
end

local function freezeController(s, frozen)
    local hum = s.humanoid

    if not hum or not hum.Parent then
        return
    end

    if frozen then
        if not s.savedMovement then
            s.savedMovement = {
                walk = hum.WalkSpeed,
                auto = hum.AutoRotate,
                useJumpPower = hum.UseJumpPower,
                jumpPower = hum.JumpPower,
                jumpHeight = hum.JumpHeight,
            }
        end

        s.freezeCF = s.root.CFrame

        hum.WalkSpeed = 0
        hum.AutoRotate = false

        if hum.UseJumpPower then
            hum.JumpPower = 0
        else
            hum.JumpHeight = 0
        end

        if s.controls then
            pcall(function()
                s.controls:Disable()
            end)
        end

        s.frozen = true

    else
        local saved = s.savedMovement

        if saved then
            hum.WalkSpeed = saved.walk
            hum.AutoRotate = saved.auto
            hum.UseJumpPower = saved.useJumpPower
            hum.JumpPower = saved.jumpPower
            hum.JumpHeight = saved.jumpHeight
        end

        if s.controls then
            pcall(function()
                s.controls:Enable()
            end)
        end

        s.frozen = false
    end
end

local function sanitizeClone(clone, original)
    -- Remove scripts, controllers and tools from the visual shell.
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("LocalScript")
            or obj:IsA("Script")
            or obj:IsA("Tool")
        then
            obj:Destroy()
        end
    end

    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:Destroy()
    end

    -- Pure visual body: welded/jointed to one anchored root.
    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Anchored = false
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Massless = true
            obj.AssemblyLinearVelocity = ZERO
            obj.AssemblyAngularVelocity = ZERO
            obj.LocalTransparencyModifier = 0
        end
    end

    local root = clone:FindFirstChild("HumanoidRootPart")
    if root then
        root.Anchored = true
        root.Transparency = 1
        root.LocalTransparencyModifier = 1
    end

    -- Explicitly restore the clone head's authored appearance.
    -- This avoids the "solid black head" effect seen on some avatar heads.
    local sourceHead = original:FindFirstChild("Head")
    local cloneHead = clone:FindFirstChild("Head")

    if sourceHead and cloneHead
        and sourceHead:IsA("BasePart")
        and cloneHead:IsA("BasePart")
    then
        cloneHead.Color = sourceHead.Color
        cloneHead.Material = sourceHead.Material
        cloneHead.Reflectance = sourceHead.Reflectance
        cloneHead.Transparency = sourceHead.Transparency

        if sourceHead:IsA("MeshPart")
            and cloneHead:IsA("MeshPart")
        then
            pcall(function()
                cloneHead.TextureID = sourceHead.TextureID
            end)
        end

        for _, sourceChild in ipairs(sourceHead:GetChildren()) do
            if sourceChild:IsA("Decal")
                or sourceChild:IsA("Texture")
            then
                local target =
                    cloneHead:FindFirstChild(sourceChild.Name)

                if target
                    and target.ClassName == sourceChild.ClassName
                then
                    target.Transparency =
                        sourceChild.Transparency

                    if target:IsA("Decal") then
                        target.Texture = sourceChild.Texture
                        target.Color3 = sourceChild.Color3
                    elseif target:IsA("Texture") then
                        target.Texture = sourceChild.Texture
                        target.Color3 = sourceChild.Color3
                    end
                end
            end
        end
    end
end

local function collectJoints(clone)
    local roles = {}
    local count = 0

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Motor6D")
            and obj.Part0
            and obj.Part1
        then
            local role = roleByPart[obj.Part1.Name]

            if role then
                local axis = obj.C1.Rotation

                roles[role] = roles[role] or {}
                table.insert(roles[role], {
                    joint = obj,
                    kind = "Motor6D",
                    axis = axis,
                    invAxis = axis:Inverse(),
                    pose = ID,
                })

                count += 1
            end

        elseif obj.ClassName == "AnimationConstraint" then
            local a1 = obj.Attachment1

            if a1 and a1.Parent then
                local role = roleByPart[a1.Parent.Name]

                if role then
                    local axis = a1.CFrame.Rotation

                    pcall(function()
                        obj.IsKinematic = true
                    end)

                    roles[role] = roles[role] or {}
                    table.insert(roles[role], {
                        joint = obj,
                        kind = "AnimationConstraint",
                        axis = axis,
                        invAxis = axis:Inverse(),
                        pose = ID,
                    })

                    count += 1
                end
            end
        end
    end

    return roles, count
end

local function applyRole(s, role, target, smooth)
    local list = s.roles[role]
    if not list then
        return
    end

    for _, entry in ipairs(list) do
        entry.pose = entry.pose:Lerp(target, smooth)

        if entry.joint.Parent then
            -- Critical R6 fix:
            -- express the requested rotation in the limb's bind axes.
            local converted =
                entry.invAxis
                * entry.pose
                * entry.axis

            entry.joint.Transform = converted
        end
    end
end

local function setCloneVisible(s, visible)
    if not s.clone then
        return
    end

    for _, obj in ipairs(s.clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Name == "HumanoidRootPart" then
                obj.LocalTransparencyModifier = 1
            else
                obj.LocalTransparencyModifier =
                    visible and 0 or 1
            end

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if s.cloneTransparency[obj] == nil then
                s.cloneTransparency[obj] = obj.Transparency
            end

            obj.Transparency =
                visible and s.cloneTransparency[obj] or 1
        end
    end

    s.cloneVisible = visible
end

local function buildClone(s)
    local original = s.character
    local oldArchivable = original.Archivable

    original.Archivable = true
    local clone = original:Clone()
    original.Archivable = oldArchivable

    if not clone then
        return false
    end

    clone.Name = "__XENO_PROC_VISUAL_" .. LP.Name

    sanitizeClone(clone, original)

    clone.Parent = Workspace

    local root = clone:FindFirstChild("HumanoidRootPart")
    if not root then
        clone:Destroy()
        return false
    end

    root.CFrame = s.root.CFrame

    s.clone = clone
    s.cloneRoot = root
    s.roles, s.jointCount = collectJoints(clone)

    if s.jointCount == 0 then
        clone:Destroy()
        s.clone = nil
        return false
    end

    setCloneVisible(s, false)

    return true
end

local function updatePose(s, now, dt)
    local root = s.root
    local hum = s.humanoid

    local measured = root.AssemblyLinearVelocity

    if measured.Magnitude > 90 then
        measured = measured.Unit * 90
    end

    local oldY = s.velocity.Y

    s.velocity =
        s.velocity:Lerp(
            measured,
            damp(CFG.VelocitySmoothness, dt)
        )

    local planar = horizontal(s.velocity)
    local speed = planar.Magnitude

    local localVelocity =
        root.CFrame:VectorToObjectSpace(planar)

    if speed > 0.2 then
        local alpha = damp(12, dt)

        s.forward = mix(
            s.forward,
            -localVelocity.Z / speed,
            alpha
        )

        s.side = mix(
            s.side,
            localVelocity.X / speed,
            alpha
        )
    end

    local humanoidState = hum:GetState()

    local grounded =
        hum.FloorMaterial ~= Enum.Material.Air

    if humanoidState == Enum.HumanoidStateType.Jumping
        and measured.Y > 2
    then
        grounded = false
    end

    if s.grounded == false
        and grounded
        and oldY < -4
    then
        s.landing = math.max(
            s.landing,
            clamp(-oldY / 45, 0, 1)
        )
    end

    s.grounded = grounded
    s.landing *= math.exp(-11 * dt)

    s.air = mix(
        s.air,
        grounded and 0 or 1,
        damp(13, dt)
    )

    s.move = mix(
        s.move,
        grounded
            and clamp((speed - 0.1) / 2.5, 0, 1)
            or 0,
        damp(10, dt)
    )

    local scale = s.r6 and 1 or 1.05

    local cycles = clamp(
        speed / (CFG.StudsPerCycle * scale),
        0.5,
        2.8
    )

    s.phase = (
        s.phase
        + dt * TAU * cycles * s.move
    ) % TAU

    local look = root.CFrame.LookVector

    if s.lastLook then
        local a = horizontal(s.lastLook)
        local b = horizontal(look)

        if a.Magnitude > 0.1
            and b.Magnitude > 0.1
        then
            local angle = math.atan2(
                a:Cross(b).Y,
                a:Dot(b)
            )

            s.turn = mix(
                s.turn,
                clamp(
                    angle / math.max(dt, 1 / 240),
                    -5,
                    5
                ),
                damp(9, dt)
            )
        end
    end

    s.lastLook = look

    local run = clamp(
        (speed - CFG.RunStartsAt)
            / (CFG.FullRunAt - CFG.RunStartsAt),
        0,
        1
    )

    local move = s.move
    local forward = s.forward
    local side = s.side

    local wave = math.sin(s.phase)
    local swing = math.cos(s.phase)

    local leftLift = math.max(swing, 0)
    local rightLift = math.max(-swing, 0)

    local air = s.air
    local landing = s.landing

    local breath =
        math.sin(now * 1.85 + s.seed)

    local idle =
        math.sin(now * 0.72 + s.seed * 0.5)

    local stride = rad(
        mix(
            CFG.WalkLegSwing,
            CFG.RunLegSwing,
            run
        )
    ) * move

    local armSwing = rad(
        mix(
            CFG.WalkArmSwing,
            CFG.RunArmSwing,
            run
        )
    ) * move

    local hipL =
        wave * stride * forward

    local hipR =
        -wave * stride * forward

    local hipSide =
        wave * stride * side * 0.62

    local jumpUp =
        clamp(s.velocity.Y / 30, 0, 1)

    local fall =
        clamp(-s.velocity.Y / 55, 0, 1)

    local kneeL =
        -rad(47 + 18 * run)
        * leftLift
        * move
        - rad(20) * landing

    local kneeR =
        -rad(47 + 18 * run)
        * rightLift
        * move
        - rad(20) * landing

    kneeL -=
        rad(23 + 18 * jumpUp) * air

    kneeR -=
        rad(17 + 13 * jumpUp) * air

    hipL +=
        rad(17 + 17 * jumpUp) * air
        + rad(8) * landing

    hipR +=
        rad(9 + 10 * jumpUp) * air
        + rad(8) * landing

    local pitch =
        -rad(CFG.BodyLean)
        * forward
        * move
        * (1 + run * 0.45)

    local roll =
        -rad(5.2) * side * move
        - s.turn * 0.018 * move
        + rad(1.5) * wave * move

    local twist =
        rad(3.8)
        * wave
        * forward
        * move

    local bob =
        (math.cos(s.phase * 2) - 1)
        * CFG.BodyBob
        * 0.5
        * move
        + breath * 0.014 * (1 - move)
        - landing * 0.19

    local rootShare =
        s.r6 and 1 or 0.55

    local armAir =
        rad(12 + 22 * fall) * air

    local leftArm =
        -wave * armSwing * forward
        + rad(10) * air
        + rad(2.2) * idle * (1 - move)

    local rightArm =
        wave * armSwing * forward
        + rad(10) * air
        - rad(2.2) * idle * (1 - move)

    local elbow =
        rad(8 + 17 * run)
        + rad(18) * air

    local reveal = clamp(
        (now - s.revealStarted)
            / CFG.RevealSeconds,
        0,
        1
    )

    local flourish =
        (1 - reveal) ^ 2

    local smooth =
        damp(CFG.PoseSmoothness, dt)

    applyRole(
        s,
        "root",
        CFrame.new(0, bob * scale, 0)
            * CFrame.Angles(
                pitch * rootShare
                    - rad(7) * flourish,
                twist,
                roll * 0.75
            ),
        smooth
    )

    applyRole(
        s,
        "waist",
        CFrame.Angles(
            pitch * 0.45
                + breath * 0.009 * (1 - move),
            -twist * 0.65,
            roll * 0.25
        ),
        smooth
    )

    applyRole(
        s,
        "neck",
        CFrame.Angles(
            -pitch * 0.7 + breath * 0.008,
            clamp(s.turn * 0.04, -0.18, 0.18),
            -roll * 0.65
        ),
        smooth
    )

    applyRole(
        s,
        "leftHip",
        CFrame.Angles(
            hipL,
            0,
            hipSide
        ),
        smooth
    )

    applyRole(
        s,
        "rightHip",
        CFrame.Angles(
            hipR,
            0,
            -hipSide
        ),
        smooth
    )

    applyRole(
        s,
        "leftKnee",
        CFrame.Angles(kneeL, 0, 0),
        smooth
    )

    applyRole(
        s,
        "rightKnee",
        CFrame.Angles(kneeR, 0, 0),
        smooth
    )

    applyRole(
        s,
        "leftAnkle",
        CFrame.Angles(
            clamp(
                -kneeL * 0.52 - hipL * 0.3,
                -0.45,
                0.6
            ),
            0,
            -hipSide * 0.35
        ),
        smooth
    )

    applyRole(
        s,
        "rightAnkle",
        CFrame.Angles(
            clamp(
                -kneeR * 0.52 - hipR * 0.3,
                -0.45,
                0.6
            ),
            0,
            hipSide * 0.35
        ),
        smooth
    )

    applyRole(
        s,
        "leftShoulder",
        CFrame.Angles(
            leftArm + rad(12) * flourish,
            0,
            -rad(3)
                - armAir
                - hipSide * 0.5
                - rad(42) * flourish
        ),
        smooth
    )

    applyRole(
        s,
        "rightShoulder",
        CFrame.Angles(
            rightArm + rad(12) * flourish,
            0,
            rad(3)
                + armAir
                + hipSide * 0.5
                + rad(42) * flourish
        ),
        smooth
    )

    applyRole(
        s,
        "leftElbow",
        CFrame.Angles(
            elbow
                + math.max(leftArm, 0) * 0.4,
            0,
            0
        ),
        smooth
    )

    applyRole(
        s,
        "rightElbow",
        CFrame.Angles(
            elbow
                + math.max(rightArm, 0) * 0.4,
            0,
            0
        ),
        smooth
    )

    applyRole(
        s,
        "leftWrist",
        CFrame.Angles(-rad(4), 0, rad(2)),
        smooth
    )

    applyRole(
        s,
        "rightWrist",
        CFrame.Angles(-rad(4), 0, -rad(2)),
        smooth
    )
end

local function installDeathGuard(s)
    if not CFG.ClientDeathGuard then
        return
    end

    local hum = s.humanoid

    hum.BreakJointsOnDeath = false
    hum.RequiresNeck = false

    pcall(function()
        hum:SetStateEnabled(
            Enum.HumanoidStateType.Dead,
            false
        )
    end)

    local correcting = false

    table.insert(
        s.localConnections,
        hum.HealthChanged:Connect(function(h)
            if correcting
                or not running
                or state ~= s
                or h > 0
            then
                return
            end

            correcting = true

            pcall(function()
                hum.Health = 1
                hum:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end)

            correcting = false
        end)
    )
end

local function destroyState(s)
    if not s then
        return
    end

    disconnectAll(s.localConnections)
    freezeController(s, false)

    if s.originalHidden then
        hideOriginal(s, false)
    end

    if s.clone then
        s.clone:Destroy()
    end
end

local function makeState(character)
    local hum =
        character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid", 10)

    local root =
        character:FindFirstChild("HumanoidRootPart")
        or character:WaitForChild("HumanoidRootPart", 10)

    if not hum or not root then
        return nil
    end

    return {
        character = character,
        humanoid = hum,
        root = root,

        clone = nil,
        cloneRoot = nil,
        roles = {},
        jointCount = 0,

        originalVisibility = {},
        cloneTransparency = {},

        originalHidden = false,
        cloneVisible = false,

        r6 = hum.RigType == Enum.HumanoidRigType.R6,

        velocity = ZERO,
        move = 0,
        forward = 1,
        side = 0,
        turn = 0,
        air = 0,
        landing = 0,
        grounded = nil,

        phase = (
            Workspace:GetServerTimeNow() * 1.37
            + (LP.UserId % 173) / 173 * TAU
        ) % TAU,

        seed =
            (LP.UserId % 131) / 131 * TAU,

        lastLook = root.CFrame.LookVector,
        lastTime = Workspace:GetServerTimeNow(),

        revealStarted = math.huge,

        controls = getControls(),
        savedMovement = nil,
        frozen = false,
        freezeCF = nil,

        localConnections = {},
    }
end

local function fakePermadeathTransition(s)
    hideOriginal(s, true)
    freezeController(s, true)

    local started = os.clock()

    while running
        and state == s
        and s.character.Parent
        and os.clock() - started < CFG.FakePermadeathSeconds
    do
        RunService.Heartbeat:Wait()
    end

    if not running
        or state ~= s
        or not s.character.Parent
    then
        return
    end

    if not buildClone(s) then
        freezeController(s, false)
        hideOriginal(s, false)
        return
    end

    s.revealStarted =
        Workspace:GetServerTimeNow()

    freezeController(s, false)

    if enabled then
        setCloneVisible(s, true)
    else
        hideOriginal(s, false)
    end
end

local function bindCharacter(character)
    if state then
        destroyState(state)
        state = nil
    end

    local s = makeState(character)

    if not s then
        return
    end

    state = s

    installDeathGuard(s)

    table.insert(
        s.localConnections,
        character.DescendantAdded:Connect(function(obj)
            if state ~= s
                or not s.originalHidden
            then
                return
            end

            saveVisibility(s, obj)

            if obj:IsA("BasePart") then
                obj.LocalTransparencyModifier = 1
            elseif obj:IsA("Decal")
                or obj:IsA("Texture")
            then
                obj.Transparency = 1
            end
        end)
    )

    task.spawn(fakePermadeathTransition, s)
end

table.insert(
    connections,
    RunService.PreSimulation:Connect(function()
        local s = state

        if not running or not s then
            return
        end

        if s.frozen
            and s.root
            and s.root.Parent
            and s.freezeCF
        then
            s.root.AssemblyLinearVelocity = ZERO
            s.root.AssemblyAngularVelocity = ZERO
            s.root.CFrame = s.freezeCF
            return
        end

        if not enabled
            or not s.clone
            or not s.clone.Parent
            or not s.cloneRoot
            or not s.cloneRoot.Parent
            or not s.root.Parent
        then
            return
        end

        -- Anchored visual root follows the actual controller.
        s.cloneRoot.CFrame = s.root.CFrame

        local now =
            Workspace:GetServerTimeNow()

        local dt = clamp(
            now - s.lastTime,
            1 / 500,
            0.1
        )

        s.lastTime = now

        updatePose(s, now, dt)
    end)
)

RunService:BindToRenderStep(
    "__XENO_PROC_VISIBILITY",
    Enum.RenderPriority.Camera.Value + 5,
    function()
        local s = state

        if not running or not s then
            return
        end

        -- Camera scripts can rewrite the real body's local transparency.
        if s.originalHidden then
            hideOriginal(s, true)
        end

        if not s.clone
            or not s.cloneVisible
            or not CFG.HideCloneHeadInFirstPerson
        then
            return
        end

        local camera = Workspace.CurrentCamera
        local head = s.clone:FindFirstChild("Head")

        if camera
            and head
            and head:IsA("BasePart")
        then
            local firstPerson =
                (
                    camera.CFrame.Position
                    - head.Position
                ).Magnitude
                <= CFG.FirstPersonDistance

            head.LocalTransparencyModifier =
                firstPerson and 1 or 0
        end
    end
)

renderBound = true

table.insert(
    connections,
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed
            or input.KeyCode ~= CFG.ToggleKey
        then
            return
        end

        enabled = not enabled

        local s = state
        if not s then
            return
        end

        if enabled then
            hideOriginal(s, true)

            if s.clone then
                s.revealStarted =
                    Workspace:GetServerTimeNow()

                setCloneVisible(s, true)
            end
        else
            if s.clone then
                setCloneVisible(s, false)
            end

            hideOriginal(s, false)
        end
    end)
)

table.insert(
    connections,
    LP.CharacterAdded:Connect(function(character)
        task.spawn(bindCharacter, character)
    end)
)

table.insert(
    connections,
    LP.CharacterRemoving:Connect(function(character)
        local s = state

        if s and s.character == character then
            destroyState(s)
            state = nil
        end
    end)
)

local function cleanup()
    if not running then
        return
    end

    running = false

    if renderBound then
        pcall(function()
            RunService:UnbindFromRenderStep(
                "__XENO_PROC_VISIBILITY"
            )
        end)
        renderBound = false
    end

    disconnectAll(connections)

    if state then
        destroyState(state)
        state = nil
    end

    if ENV.__XENO_PROC_REANIM_CLEANUP == cleanup then
        ENV.__XENO_PROC_REANIM_CLEANUP = nil
    end
end

ENV.__XENO_PROC_REANIM_CLEANUP = cleanup

if LP.Character then
    task.spawn(bindCharacter, LP.Character)
end

print(
    "[XenoProceduralReanim] loaded | "
    .. tostring(CFG.FakePermadeathSeconds)
    .. "s fake-permadeath | RightShift toggle"
)
